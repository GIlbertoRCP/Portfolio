---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const base = '/Portfolio';

// Accent classes are written out in full so Tailwind can find them.
const accents = {
  blue: { text: 'text-blue-400', hover: 'group-hover:text-blue-400' },
  amber: { text: 'text-amber-400', hover: 'group-hover:text-amber-400' },
  purple: { text: 'text-purple-400', hover: 'group-hover:text-purple-400' },
  cyan: { text: 'text-cyan-400', hover: 'group-hover:text-cyan-400' },
  emerald: { text: 'text-emerald-400', hover: 'group-hover:text-emerald-400' },
};

const featured = [
  {
    title: 'Raymarcher: Light in Curved Spacetime',
    slug: 'raymarcher',
    thumb: 'raymarcher.jpg',
    accent: 'blue',
    summary: 'A compiler turns a spacetime metric into CUDA and WebGPU ray tracers that render black holes in real time.',
    result: 'Physics matches Bardeen (1973) and other published results to 10⁻¹⁰. CUDA and WebGPU agree on all 14M test pixels.',
    tags: ['CUDA C++', 'WebGPU', 'TypeScript'],
    code: 'https://github.com/GIlbertoRCP/raymarcher',
    live: 'https://gilbertorcp.github.io/raymarcher/',
  },
  {
    title: 'predictive-audit',
    slug: 'predictive-audit',
    accent: 'amber',
    summary: 'Checks forecasting results against trivial baselines and evaluation leaks. I built it after finding my own team’s model failed.',
    result: 'Ran it on 5 published results: 4 don’t clearly beat persistence or a moving average.',
    tags: ['Python', 'Time series', 'Bootstrap'],
    code: 'https://github.com/GIlbertoRCP/predictive_audit',
  },
  {
    title: 'F1 Winner Oracle',
    slug: 'f1-oracle',
    thumb: 'f1-oracle.jpg',
    accent: 'purple',
    summary: 'Calibrated race-winner odds, frozen before each race in a hash-chained log and scored in public.',
    result: 'Log loss 1.24 vs 1.53 for “pole sitter wins” over 174 walk-forward races. No better as a single pick, and the site says so.',
    tags: ['Python', 'GitHub Actions', 'JavaScript'],
    code: 'https://github.com/GIlbertoRCP/F1-Prediction',
    live: 'https://gilbertorcp.github.io/F1-Prediction/',
  },
  {
    title: 'Spatial Pipeline: Photo Hotspot Engine',
    slug: 'spatial-pipeline',
    thumb: 'spatial-pipeline.jpg',
    accent: 'cyan',
    summary: 'Finds wildlife and nature photo hotspots in geotagged observations using equal-area hexes, unique-photographer counts, Moran’s I and Getis-Ord Gi*.',
    result: 'On a month of Denver-area iNaturalist data (6,417 observations, 954 observers), significant Gi* hotspots land where a naturalist would point you.',
    tags: ['Python', 'Spatial stats', 'deck.gl'],
    code: 'https://github.com/GIlbertoRCP/spatial_pipeline',
    live: 'https://gilbertorcp.github.io/spatial_pipeline/',
    liveLabel: 'Docs',
  },
  {
    title: 'WhispNotes',
    slug: 'whisp-notes',
    thumb: 'whispnotes.jpg',
    accent: 'cyan',
    summary: 'Native macOS note app with on-device Whisper transcription, a local Gemma 3 assistant and a knowledge graph.',
    result: 'Ships as a DMG through GitHub Releases, with CI and a test suite.',
    tags: ['Swift', 'SwiftUI', 'whisper.cpp'],
    code: 'https://github.com/GIlbertoRCP/whispNotes',
    live: 'https://github.com/GIlbertoRCP/whispNotes/releases',
    liveLabel: 'Download',
  },
  {
    title: 'Movie Match',
    slug: 'movie-matcher',
    accent: 'purple',
    summary: 'Two people swipe on movies together in real time. A two-tower recommender adapts to both of them as they go.',
    result: 'Full stack: React 19, Node/Express, Socket.IO rooms, SQLite, JWT and OIDC auth, CI.',
    tags: ['React', 'Socket.IO', 'Recommenders'],
    code: 'https://github.com/GIlbertoRCP/movie_match',
  },
];

const more = [
  {
    title: 'Literature Companion',
    slug: 'literature-companion',
    accent: 'emerald',
    summary: 'Local desktop RAG app for papers and codebases: BM25 + dense retrieval fused with RRF, and SM-2 flashcards.',
    tags: ['Tauri', 'FastAPI', 'ChromaDB'],
    code: 'https://github.com/GIlbertoRCP/ficP',
  },
  {
    title: 'Predictive SDN (team of 4)',
    slug: 'predictive-sdn',
    accent: 'blue',
    summary: 'Kafka-based SDN telemetry with LSTM congestion forecasting and a DQN polling agent, in Mininet. Course project.',
    tags: ['Kafka', 'PyTorch', 'Mininet'],
    code: 'https://github.com/GIlbertoRCP/Predictive_Activation',
  },
  {
    title: 'Humanoid Locomotion',
    slug: 'motor-control-locomotion',
    accent: 'emerald',
    summary: 'PPO agent trained in MuJoCo to walk over uneven terrain using a 5-point vertical rangefinder.',
    tags: ['MuJoCo', 'PPO', 'Reward shaping'],
  },
  {
    title: 'Wireless EOD Rover',
    slug: 'bomb-squad-robot',
    accent: 'blue',
    summary: 'Three ESP32 nodes over ESP-NOW: a controller, a Mecanum rover with a 4-DOF claw, and a tremor-sensing target.',
    tags: ['ESP32', 'ESP-NOW', 'C++'],
  },
];

const skills = [
  { area: 'GPU & performance', items: 'CUDA C++, NVRTC, WebGPU / WGSL, Nsight Compute, RAPIDS' },
  { area: 'ML & evaluation', items: 'PyTorch, XGBoost, scikit-learn, Stable-Baselines3, ONNX Runtime, walk-forward evaluation, bootstrap intervals' },
  { area: 'Data systems', items: 'Python, pandas, NumPy, SciPy, PyArrow, pyproj, Dask, Kafka, SQL' },
  { area: 'Apps & backends', items: 'TypeScript, React, Node.js, FastAPI, Socket.IO, Swift / SwiftUI, Tauri' },
  { area: 'Embedded', items: 'C / C++, ESP32, ESP-NOW, MPU6050' },
  { area: 'Tooling', items: 'Git, GitHub Actions, Docker, Linux, CMake' },
];

const certs = [
  { name: 'Building RAG Agents with LLMs', issued: 'November 2026', url: 'https://learn.nvidia.com/certificates?id=mLIN0nBrTV2hXFALcbVM3Q' },
  { name: 'Generative AI with Diffusion Models', issued: 'October 2026', url: 'https://learn.nvidia.com/certificates?id=vEq-w5ssQaG2Emi6CRZcJw' },
  { name: 'Building Transformer-Based NLP Applications', issued: 'September 2026', url: 'https://learn.nvidia.com/certificates?id=7VhTQxgiSbSwfn2ZcEyPHw' },
];
---

<Layout>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20 space-y-24">

    <!-- Hero Section -->
    <section class="space-y-8">
      <div class="space-y-4">
        <h1 class="text-4xl sm:text-6xl font-display font-extrabold tracking-tight text-white leading-none">
          Gilberto Romero-Cano
        </h1>
        <p class="text-sm font-mono text-slate-400 uppercase tracking-widest">
          CS student · GPU computing · ML evaluation · data systems
        </p>
      </div>

      <p class="text-base text-slate-300 leading-relaxed max-w-3xl">
        I'm a Computer Science student at <strong class="text-white">CU Denver</strong> (graduating May 2027). I build GPU and data-heavy systems and then check whether they actually work. That means validating a black-hole renderer against published physics, scoring forecasts against baselines in public, and reporting the results that didn't pan out.
      </p>

      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-400 font-mono border-y border-slate-850 py-3">
        <span>Denver, CO</span>
        <a href="mailto:gilbertorcp712@gmail.com" class="hover:text-blue-400 transition">gilbertorcp712@gmail.com</a>
        <a href="https://linkedin.com/in/gromerocano/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition">LinkedIn</a>
        <a href="https://github.com/GIlbertoRCP" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition">GitHub</a>
      </div>

      <div class="flex flex-wrap gap-4 font-mono">
        <a href="#projects" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold border border-blue-500 shadow-flat-slate transition-all text-sm uppercase tracking-wider">
          See projects &rarr;
        </a>
        <a href={`${base}/about`} class="px-5 py-2.5 bg-[#0f1115] hover:bg-slate-900 border border-slate-850 text-slate-300 hover:text-white shadow-flat-slate transition-all text-sm uppercase tracking-wider">
          About me
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    <section id="projects" class="space-y-8 scroll-mt-20">
      <div class="border-b border-slate-850 pb-4">
        <h2 class="text-2xl font-display font-extrabold text-white tracking-tight">Featured projects</h2>
        <p class="text-sm text-slate-400 mt-1">Each card lists one measured result. The case study covers how it was measured.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((p) => {
          const a = accents[p.accent];
          return (
            <article class="bg-[#0f1115] border border-slate-850 flex flex-col transition-all duration-200 hover:border-slate-700 shadow-flat-slate group overflow-hidden">
              <a href={`${base}/projects/${p.slug}`} class="block" tabindex="-1" aria-hidden="true">
                {p.thumb ? (
                  <img src={`${base}/assets/thumbs/${p.thumb}`} alt="" width="640" height="360" loading="lazy" class="w-full aspect-video object-cover border-b border-slate-850" />
                ) : (
                  <div class="w-full aspect-video border-b border-slate-850 bg-slate-950 flex items-center justify-center">
                    <span class={`font-display font-extrabold text-2xl ${a.text} opacity-60`}>{p.title}</span>
                  </div>
                )}
              </a>
              <div class="p-5 flex flex-col flex-grow">
                <h3 class={`text-lg font-display font-extrabold text-white mb-2 tracking-tight transition ${a.hover}`}>
                  <a href={`${base}/projects/${p.slug}`}>{p.title}</a>
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-3">{p.summary}</p>
                <p class="text-slate-300 text-sm leading-relaxed mb-4 border-l-2 border-slate-700 pl-3">{p.result}</p>
                <div class="flex flex-wrap gap-1.5 mb-5 font-mono text-xs mt-auto">
                  {p.tags.map((t) => <span class="px-2 py-0.5 bg-slate-900 border border-slate-850 text-slate-400">{t}</span>)}
                </div>
                <div class="flex flex-wrap gap-4 font-mono text-sm font-bold">
                  <a href={`${base}/projects/${p.slug}`} class={`${a.text} hover:underline`}>Case study &rarr;</a>
                  {p.code && <a href={p.code} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white">Code ↗</a>}
                  {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white">{p.liveLabel ?? 'Live'} ↗</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- More Projects -->
    <section class="space-y-8">
      <div class="border-b border-slate-850 pb-4">
        <h2 class="text-2xl font-display font-extrabold text-white tracking-tight">More projects</h2>
        <p class="text-sm text-slate-400 mt-1">Coursework, team projects and earlier work.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {more.map((p) => {
          const a = accents[p.accent];
          return (
            <article class="bg-[#0f1115] border border-slate-850 p-5 flex flex-col transition-all duration-200 hover:border-slate-700 shadow-flat-slate group">
              <h3 class={`text-base font-display font-bold text-white mb-2 tracking-tight transition ${a.hover}`}>
                <a href={`${base}/projects/${p.slug}`}>{p.title}</a>
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">{p.summary}</p>
              <div class="flex flex-wrap gap-1.5 mb-4 font-mono text-xs mt-auto">
                {p.tags.map((t) => <span class="px-2 py-0.5 bg-slate-900 border border-slate-850 text-slate-400">{t}</span>)}
              </div>
              <div class="flex flex-wrap gap-4 font-mono text-sm font-bold">
                <a href={`${base}/projects/${p.slug}`} class={`${a.text} hover:underline`}>Case study &rarr;</a>
                {p.code && <a href={p.code} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white">Code ↗</a>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Skills -->
    <section class="space-y-8">
      <div class="border-b border-slate-850 pb-4">
        <h2 class="text-2xl font-display font-extrabold text-white tracking-tight">Skills</h2>
        <p class="text-sm text-slate-400 mt-1">Grouped by what I use them for. Each one appears in at least one project above.</p>
      </div>
      <dl class="border border-slate-850 divide-y divide-slate-850 bg-slate-950">
        {skills.map((s) => (
          <div class="grid sm:grid-cols-[200px_1fr] gap-1 sm:gap-6 p-4">
            <dt class="text-sm font-mono font-bold text-white">{s.area}</dt>
            <dd class="text-sm text-slate-400">{s.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Certifications -->
    <section class="space-y-6">
      <div class="border-b border-slate-850 pb-4">
        <h2 class="text-2xl font-display font-extrabold text-white tracking-tight">Certifications</h2>
      </div>
      <ul class="space-y-3">
        {certs.map((c) => (
          <li class="bg-[#0f1115] border border-slate-850 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-white">{c.name}</p>
              <p class="text-xs text-slate-500 mt-0.5">NVIDIA Deep Learning Institute · {c.issued}</p>
            </div>
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-sm font-mono font-bold text-[#76b900] hover:underline self-start sm:self-auto">Verify ↗</a>
          </li>
        ))}
      </ul>
    </section>

  </main>
</Layout>
